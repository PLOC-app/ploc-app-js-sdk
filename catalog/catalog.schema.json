{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PLOC SDK catalog",
  "type": "object",
  "required": ["sdkVersion", "count", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "sdkVersion": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "object",
      "description": "Keys: \"service.method\" (ui.openWine, cellar.wine.getAll), \"Class#method\" (instance) or \"Class.method\" (static).",
      "additionalProperties": {
        "type": "object",
        "required": ["desc", "params", "snippet"],
        "properties": {
          "desc": { "type": "string", "minLength": 1 },
          "snippet": { "type": "string", "minLength": 1 },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "optional": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
